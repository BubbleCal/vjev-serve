    "labels": {"home": "inside a home", "office": "office or workplace", "shop": "shop or restaurant", "street": "street or city", "road": "road or highway", "nature": "nature - forest, mountain, field", "water": "beach, sea, lake or river", "sports": "sports venue", "transport": "inside a vehicle, station or airport", "other": "somewhere else"}
  },
  "weather": {
    "about": "What the weather is like.",
    "multiple": false,
    "labels": {"sunny": "sunny or clear", "cloudy": "cloudy or overcast", "rain": "rain", "snow": "snow", "fog": "fog or mist", "night": "night - weather not visible", "indoors": "indoors - weather not visible"}
