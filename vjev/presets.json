    "labels": {"joy": "joy", "sadness": "sadness", "anger": "anger", "fear": "fear", "surprise": "surprise", "disgust": "disgust", "love": "love or affection", "gratitude": "gratitude", "confusion": "confusion", "neutral": "no particular emotion"}
