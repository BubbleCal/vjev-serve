    "labels": {"person": "person", "car": "car", "bicycle": "bicycle", "bus": "bus", "truck": "truck", "dog": "dog", "cat": "cat", "bird": "bird", "chair": "chair", "table": "dining table", "bed": "bed", "tv": "tv or monitor", "laptop": "laptop", "phone": "cell phone", "book": "book", "bottle": "bottle", "cup": "cup", "food": "food", "plant": "potted plant", "bag": "bag or backpack"}
  },
