    "about": "Which colours something has or shows.",
    "multiple": true,
    "labels": {"red": "red", "orange": "orange", "yellow": "yellow", "green": "green", "blue": "blue", "purple": "purple", "pink": "pink", "brown": "brown", "black": "black", "white": "white", "gray": "gray"}
  },
